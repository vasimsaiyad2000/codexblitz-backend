APP_NAME=codexblitz-backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/codexblitz
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=replace-with-your-model

# Pydantic Settings parses list values as JSON.
CORS_ORIGINS=["http://localhost:3000"]
ANALYZE_RATE_LIMIT_PER_MINUTE=5

# memory:// works for local single-process development.
# Use a shared Redis URL in production/multi-worker deployments.
RATE_LIMIT_STORAGE_URI=memory://

# When behind a reverse proxy, configure Uvicorn to trust forwarded headers
# only from your proxy so rate limits use the actual client IP.
